# ---- Node / Next.js ----
node_modules/
.next/
# NEXT_DIST_DIR 로 격리 빌드할 때의 대체 산출물 (frontend/next.config.mjs 참조)
.next-*/
out/
dist/
build/
# LR-T2 데스크톱 앱 아이콘(electron-builder buildResources) — 위 build/ 제외의 예외
!/desktop/build/
*.tsbuildinfo
.pnp.*
.yarn/

# M6-T8a electron-builder 로컬 빌드 출력 (desktop/electron-builder.yml directories.output)
/desktop/release/

# ---- Python ----
.venv/
venv/
# M6-T2 스탠드얼론 패키징 스파이크 산출물 (backend/scripts/package_standalone.py)
/backend/dist_standalone/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ---- Env & secrets ----
# `.env` 만 막으면 `.env.keys`/`.env.prod`/`.env.bak` 같은 변종이 그대로 커밋된다
# (M4-T10 감사에서 실제로 `.env.keys` 가 추적 대상이었다). BYOK 프로젝트에서 이건
# 그냥 사고이므로 **전부 막고 예시 파일만 되살린다**.
.env*
!.env.example
*.pem
secrets.json
*.key

# ---- Reference clones (Spec §4.3-4: 읽기 전용 참고, 배포 제외) ----
/reference/

# ---- Runtime ----
workspace/
*.log
coverage/
playwright-report/
test-results/
.acanvas-runs/

# ---- OS / Editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
.playwright-mcp/

# ---- 내부 전용 문서 (git에 올리지 않음, 로컬 작업 일지/스펙 원본) ----
/MEMORY.md
/WORK_PLAN.md
/docs/AgentCanvas_Master_Build_Spec_v3.md
