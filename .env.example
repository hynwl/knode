# ============================================================
# Knode — 환경변수 예시 (Spec §19.3)
# 이 파일을 .env 로 복사해서 사용하세요. API 키는 여기 넣지 않습니다.
# API 키는 브라우저 UI(설정 → API Keys)에서 입력하며 헤더로만 전송됩니다. (Spec §12)
# ============================================================

# ---- Backend ----
ALLOWED_ORIGINS=http://localhost:3000
OLLAMA_HOST=http://localhost:11434
MAX_CONCURRENT_RUNS=3
RUN_TTL_SECONDS=1800
MAX_RUN_DURATION_S=900
WORKSPACE_DIR=./workspace
ENABLE_CODE_INTERPRETER=false
PERSISTENCE_MODE=none
LOG_LEVEL=INFO

# ---- Frontend ----
# ⚠️ 스펙 §19.3 표는 `NEXT_PUBLIC_API_BASE`로 적었으나 실제 코드(run/client.ts 등
# 4곳)는 `NEXT_PUBLIC_API_BASE_URL`을 읽는다. 여기는 코드 기준으로 맞춘다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---- 선택: Hub 레지스트리 (M5 P1) ----
# 비워 두면 self-host 는 아무 영향 없이 100% 동작합니다 — 갤러리 모달의 "Hub" 탭
# 자체가 렌더링되지 않습니다(M5 P-D3). 설정하면 그 값의 `index.json` 을 읽어
# 팀을 보여주고, 카드의 "Fork"가 `<url>/teams/<slug>/team.acanvas.json` 을 받아
# 새 로컬 캔버스를 만듭니다. 값은 정적 파일이 실제로 놓인 위치(디렉터리)여야
# 하며 끝에 슬래시를 붙이지 않습니다 — 예: knode-hub 리포를 GitHub raw 로
# 그대로 서빙하는 경우.
# NEXT_PUBLIC_HUB_REGISTRY_URL=https://raw.githubusercontent.com/hynwl/knode-hub/main
#
# 게시(Publish) 2단계는 "PR 로 제출하라"고 안내하는데, 위 값은 정적 파일이 놓인
# 자리라 그대로는 PR 을 열 수 없습니다. 위 예시처럼 GitHub raw 형태면 리포 주소를
# 자동으로 유도하므로 아래 값은 보통 필요 없습니다. 레지스트리를 다른 호스트
# (CDN·사내 정적 서버 등)로 서빙할 때만 채우세요 — 비어 있고 유도도 안 되면
# 가이드가 링크 없이 단계만 보여줍니다.
# NEXT_PUBLIC_HUB_REPO_URL=https://github.com/hynwl/knode-hub

# ---- 선택: 서버 사이드 폴백 키 (권장하지 않음) ----
# 헤더로 전달된 키가 항상 우선합니다. Spec §12.1
# ⚠️ 브라우저에서 프로바이더당 키를 여러 개 등록한 경우(키 슬롯), 서버 폴백은
#    "기본" 슬롯에만 적용됩니다 — 별칭이 붙은 슬롯은 브라우저에만 존재합니다.
# OPENAI_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# SERPER_API_KEY=
# openai_compatible 프로바이더(자체 호스팅 엔드포인트) 전용 키.
# OPENAI_API_KEY 와 절대 공유하지 않습니다 — base_url 로 지정한 임의의 호스트에
# OpenAI 본계정 키가 전송되는 것을 막기 위해서입니다.
# OPENAI_COMPATIBLE_API_KEY=
